# Writ — all secrets are SERVER-SIDE only (never NEXT_PUBLIC, never in the client bundle).
# In Railway, set these as service variables. Locally, copy to .env.local (gitignored).
# PLACEHOLDERS ONLY — no working default keys exist anywhere in the repo. Signing
# endpoints FAIL CLOSED when a key below is unset.

# CSPR.cloud (data reads: roster + attribution trail). Server-side only.
CSPR_CLOUD_KEY=

# CSPR.click (wallet connect/sign). Public app id is fine client-side; set per CSPR.click.
NEXT_PUBLIC_CSPR_CLICK_APP_ID=
NEXT_PUBLIC_CSPR_CLICK_APP_NAME=Writ

# Casper network
CASPER_NODE=https://node.testnet.casper.network/rpc
CASPER_CHAIN=casper-test
ASSET_ID=writ-bond-001
REGISTRY_PKG=hash-74148da7b68ce51e4dfa822af7106daaea7140862106a7b675057caf9ee404ce

# Attestation signing — REQUIRED (attest fails closed without them).
# base64 of the ed25519 secret_key.pem. TESTNET-ONLY THROWAWAY keys; never reuse a
# real key. These are two of the registry's three registered quorum keys — held by
# ONE server process, i.e. a 2-signature demo attestation from a single trust domain
# (documented in README "Attestation trust model").
QUORUM_KEY_1=
QUORUM_KEY_2=
CASPER_COORDINATOR_KEY=

# Demo issuer EdDSA key (BabyJubJub, 32-byte hex) — REQUIRED; there is NO default.
# Generate: openssl rand -hex 32
# This key plays the KYC-issuer role for the demo; production would replace it with
# a real external issuer.
ISSUER_EDDSA_KEY=

# Sanctions screening
# Comma-separated Casper account hashes for the DEMO denylist (illustrative — the
# live OFAC list holds ETH addresses and is screened against a linked ETH address).
DEMO_SANCTIONED_ACCOUNTS=

# Credential lifetime in seconds (on-chain expiry = now + TTL; registry enforces it).
CREDENTIAL_TTL_SECS=7776000

# Onboarding guards (optional overrides)
ONBOARD_RATE_MAX=4
ONBOARD_GLOBAL_CAP=200

# Attest deploy payment cap in motes (default 90 CSPR). Consumed is ~15 CSPR; the
# coordinator balance must cover the CAP upfront, so lower this on a low-balance
# testnet coordinator (e.g. 22000000000 = 22 CSPR).
ATTEST_PAYMENT_MOTES=90000000000
